# Dashboard privé — OBLIGATOIRE en production
NUXT_ADMIN_PASSWORD=remplacez-par-un-mot-de-passe-long
NUXT_ADMIN_SESSION_SECRET=remplacez-par-au-moins-32-caracteres-aleatoires

# Valeurs initiales avant la première sauvegarde dans le dashboard
# mock = données locales / api = votre backend autorisé compatible
NUXT_PUBLIC_CONTENT_MODE=mock

# Backend local complet
DATABASE_URL=postgresql://cinora:cinora_dev@localhost:5432/cinora
REDIS_URL=redis://localhost:6379

# API média autorisée existante (facultative jusqu'à sa disponibilité)
NUXT_PLAYBACK_API_BASE=

# Emails locaux de récupération de mot de passe (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="CINORA <noreply@cinora.local>"

# Base PUBLIQUE de votre API. Elle peut inclure le préfixe compatible.
# Exemple : https://api.votre-domaine.com/wefeed-h5api-bff
NUXT_PUBLIC_API_BASE=https://api.votre-domaine.com/wefeed-h5api-bff
NUXT_PUBLIC_API_TIMEOUT=10000
NUXT_PUBLIC_API_CALLER_SOURCE=node-frontend

# Base PRIVÉE facultative, utilisée par le proxy SSR /detail.
# Exemple réseau interne : http://content-bff.production
NUXT_API_SERVER_BASE=
